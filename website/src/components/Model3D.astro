---
interface Props {
  src: string;
  alt: string;
  poster?: string;
  class?: string;
}

const { src, alt, poster, class: className = '' } = Astro.props;
---

<model-viewer
  class={`lia-model3d ${className}`}
  src={src}
  poster={poster}
  alt={alt}
  camera-controls
  touch-action="pan-y"
  shadow-intensity="1"
  exposure="1"
  auto-rotate
  ar
  loading="lazy"
  reveal="interaction"
>
  <button slot="poster" class="lia-model3d__load">View in 3D</button>
</model-viewer>

<script>
  import '@google/model-viewer';
</script>

<style>
  .lia-model3d {
    width: 100%;
    height: 28rem;
    background: var(--color-gray-100);
    border-radius: 0.75rem;
  }

  .lia-model3d__load {
    position: absolute;
    inset: 0;
    margin: auto;
    width: fit-content;
    height: fit-content;
    padding: 0.6rem 1.2rem;
    border: none;
    border-radius: 999px;
    background: var(--color-accent-500);
    color: white;
    font-weight: 600;
    cursor: pointer;
  }
</style>
