---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  caption,
  class: className = '',
  widths = [400, 800, 1200, 1600],
  sizes = '(min-width: 1024px) 50vw, 100vw',
  loading = 'lazy',
} = Astro.props;
---

<figure class={className}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-gray-500);
    text-align: center;
  }
</style>
