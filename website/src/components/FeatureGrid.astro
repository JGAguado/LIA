---
interface Feature {
  title: string;
  description: string;
  icon: string;
}

const features: Feature[] = [
  {
    title: 'Meshtastic Powered',
    description:
      'Built on the open Meshtastic firmware and LoRa mesh protocol — no proprietary radio stack.',
    icon: 'M4 12a8 8 0 0 1 16 0 M7 12a5 5 0 0 1 10 0 M10 12a2 2 0 0 1 4 0 M12 12v.01',
  },
  {
    title: 'Long Battery Life',
    description:
      'Deep-sleep firmware and efficient power management stretch a single charge to weeks.',
    icon: 'M7 8h8a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Z M17 11h1a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1h-1 M9 12h4',
  },
  {
    title: 'GPS Tracking',
    description:
      'A dedicated GNSS module reports precise location without relying on cell networks.',
    icon: 'M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z M12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  },
  {
    title: 'Open Source',
    description:
      'Full KiCad design, and documentation are all developed in the open under a shared license.',
    icon: 'M8 9l-3 3 3 3M16 9l3 3-3 3M13 6l-2 12',
  },
];
---

<section class="lia-features" id="features">
  <h2>The off-grid device to keep your best friend on track.</h2>
  <ul class="lia-features__grid">
    {
      features.map((feature) => (
        <li class="lia-features__card">
          <svg
            viewBox="0 0 24 24"
            width="28"
            height="28"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={feature.icon} />
          </svg>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .lia-features {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  .lia-features h2 {
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 2.5rem;
    color: var(--lia-fg);
  }

  .lia-features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lia-features__card {
    padding: 1.75rem;
    border-radius: 1rem;
    background: var(--lia-surface);
    color: var(--lia-fg);
  }

  .lia-features__card svg {
    color: var(--color-accent-600);
    margin-bottom: 0.75rem;
  }

  .lia-features__card h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }

  .lia-features__card p {
    margin: 0;
    color: var(--lia-fg-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
