---
import { Image } from 'astro:assets';
import headerPhoto from '../assets/brand/Header.png';
import logoLight from '../assets/brand/Primary light.png';
import logoDark from '../assets/brand/Primary dark.png';

const base = import.meta.env.BASE_URL;
---

<section class="lia-hero">
  <div class="lia-hero__copy">
    <picture>
      <source srcset={encodeURI(logoDark.src)} media="(prefers-color-scheme: dark)" />
      <img
        class="lia-hero__logo"
        src={encodeURI(logoLight.src)}
        alt="LIA — Off-grid. On track."
        width="480"
      />
    </picture>
    <p class="lia-hero__description">
      LIA is an open-source, Meshtastic-powered pet tracker. No subscriptions, no cell towers, no
      cloud dependency — just long-range mesh radio, GPS, and hardware you can build, inspect, and
      repair yourself.
    </p>
    <div class="lia-hero__actions">
      <a class="lia-button lia-button--primary" href={`${base}/docs/getting-started/`}
        >Get Started</a
      >
      <a class="lia-button lia-button--secondary" href="https://github.com/JGAguado/LIA">GitHub</a>
    </div>
  </div>
  <div class="lia-hero__media">
    <Image
      src={headerPhoto}
      alt="LIA tracker attached to a dog's collar outdoors"
      widths={[480, 960, 1440]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      priority
    />
  </div>
</section>

<style>
  .lia-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  @media (min-width: 1024px) {
    .lia-hero {
      grid-template-columns: 1fr 1fr;
      padding: 5rem 2rem 6rem;
    }
  }

  .lia-hero__logo {
    display: block;
    width: min(100%, 24rem);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .lia-hero__description {
    max-width: 34rem;
    color: var(--lia-fg-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .lia-hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .lia-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease;
  }

  .lia-button:hover {
    transform: translateY(-1px);
  }

  .lia-button--primary {
    background: var(--color-accent-600);
    color: white;
  }

  .lia-button--primary:hover {
    background: var(--color-accent-700);
  }

  .lia-button--secondary {
    background: var(--lia-surface);
    color: var(--lia-fg);
  }

  .lia-hero__media :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    box-shadow: 0 20px 60px -20px rgb(15 23 32 / 35%);
  }
</style>
