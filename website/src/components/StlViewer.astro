---
interface Props {
  src: string;
  label: string;
  downloadHref?: string;
  height?: string;
  color?: string;
}

const { src, label, downloadHref = src, height = '24rem', color = '#2eb67d' } = Astro.props;
const id = `stl-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class="lia-stl" style={`--lia-stl-height: ${height};`}>
  <div
    class="lia-stl__canvas"
    id={id}
    data-src={src}
    data-color={color}
    role="img"
    aria-label={`Interactive 3D preview of ${label}`}
  >
    <p class="lia-stl__loading">Loading 3D preview…</p>
  </div>
  <figcaption>
    <span>{label}</span>
    <a href={downloadHref} download>Download STL</a>
  </figcaption>
</figure>

<script>
  import * as THREE from 'three';
  import { STLLoader } from 'three/addons/loaders/STLLoader.js';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

  // Browsers cap the number of simultaneous WebGL contexts (commonly
  // 8-16); a page with more <StlViewer> instances than that silently loses
  // the earliest-created contexts as later ones are requested, so only the
  // last few actually render. Each viewer is therefore only ever created
  // while its container is on screen (IntersectionObserver) and fully torn
  // down -- renderer disposed, context released, animation loop stopped --
  // the moment it scrolls back out, so an arbitrary number of viewers on
  // one page never exceeds the browser's live-context limit at once.
  function initViewer(container: HTMLElement) {
    const src = container.dataset.src!;
    const color = container.dataset.color ?? '#2eb67d';

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 1000);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.replaceChildren(renderer.domElement);

    const resize = () => {
      const { clientWidth, clientHeight } = container;
      if (clientWidth === 0 || clientHeight === 0) return;
      renderer.setSize(clientWidth, clientHeight);
      camera.aspect = clientWidth / clientHeight;
      camera.updateProjectionMatrix();
    };

    scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 2.2));
    const keyLight = new THREE.DirectionalLight(0xffffff, 1.2);
    keyLight.position.set(1, 1, 1);
    scene.add(keyLight);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;

    new STLLoader().load(
      src,
      (geometry) => {
        geometry.computeVertexNormals();
        geometry.center();

        const material = new THREE.MeshStandardMaterial({ color, roughness: 0.5, metalness: 0.1 });
        const mesh = new THREE.Mesh(geometry, material);
        mesh.rotation.x = -Math.PI / 2;
        scene.add(mesh);

        geometry.computeBoundingSphere();
        const radius = geometry.boundingSphere?.radius ?? 50;
        camera.position.set(radius * 1.8, radius * 1.4, radius * 1.8);
        controls.target.set(0, 0, 0);
        controls.update();

        resize();
      },
      undefined,
      () => {
        container.innerHTML = '<p class="lia-stl__error">Couldn\'t load the 3D preview.</p>';
      },
    );

    window.addEventListener('resize', resize);
    resize();

    let frameId = 0;
    (function animate() {
      frameId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    })();

    return () => {
      cancelAnimationFrame(frameId);
      window.removeEventListener('resize', resize);
      controls.dispose();
      renderer.dispose();
      scene.traverse((obj) => {
        if (obj instanceof THREE.Mesh) {
          obj.geometry.dispose();
          const materials = Array.isArray(obj.material) ? obj.material : [obj.material];
          materials.forEach((m) => m.dispose());
        }
      });
      container.replaceChildren();
    };
  }

  const teardowns = new WeakMap<Element, () => void>();

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const container = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          if (!teardowns.has(container)) {
            teardowns.set(container, initViewer(container));
          }
        } else {
          const teardown = teardowns.get(container);
          if (teardown) {
            teardown();
            teardowns.delete(container);
          }
        }
      }
    },
    { rootMargin: '200px' },
  );

  document.querySelectorAll<HTMLElement>('.lia-stl__canvas').forEach((container) => observer.observe(container));
</script>

<style>
  .lia-stl {
    margin: 0;
  }

  .lia-stl__canvas {
    position: relative;
    width: 100%;
    height: var(--lia-stl-height);
    border-radius: 0.75rem;
    background: var(--color-gray-100);
    overflow: hidden;
    touch-action: none;
  }

  .lia-stl__canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lia-stl__loading,
  .lia-stl__error {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    color: var(--color-gray-500);
    font-size: 0.875rem;
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-gray-600);
  }

  figcaption a {
    color: var(--color-accent-600);
    font-weight: 600;
    text-decoration: none;
  }

  figcaption a:hover {
    text-decoration: underline;
  }
</style>
