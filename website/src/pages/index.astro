---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import DocsCardGrid from '../components/DocsCardGrid.astro';
import BuildGallery from '../components/BuildGallery.astro';
---

<MarketingLayout
  title="LIA — Off-grid. On track."
  description="LIA is an open-source, Meshtastic-powered pet tracker built for off-grid, subscription-free location tracking."
>
  <Hero />
  <FeatureGrid />
  <HowItWorks />
  <DocsCardGrid />
  <BuildGallery heading="Gallery" id="build-gallery" standalone />
</MarketingLayout>
